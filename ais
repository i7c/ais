#!/usr/bin/env python3
"""ais — ai-session: start an agent harness with the right flags, env and a
tracked session, so any running agent can be found again later in tmux.

    ais [ais flags] -- <harness> [harness args...]
    ais select | ls | status | notify | prune | current | restart | install

Config lives at ~/.ais/config.toml, session state at ~/.ais/sessions.json.
Sessions are tracked only inside tmux: ais refuses to start outside it, since a
session it cannot point back to is not worth recording.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import time
import tomllib
import unicodedata
import uuid
from contextlib import contextmanager
from datetime import datetime
from pathlib import Path

PROG = "ais"
AIS_HOME = Path(os.environ.get("AIS_HOME", Path.home() / ".ais"))
CONFIG_PATH = AIS_HOME / "config.toml"
SESSIONS_PATH = AIS_HOME / "sessions.json"
LOCK_PATH = AIS_HOME / "sessions.lock"

# No 0/1/l/o: ids get read aloud and typed by hand.
ID_ALPHABET = "23456789abcdefghijkmnpqrstuvwxyz"
ID_LENGTH = 10
SESSIONS_VERSION = 1

# Notifications are kept on the session record: they are only interesting while
# the session is, and they die with it when prune drops it.
NOTIFY_KEEP = 20          # per session
NOTIFY_MAX_AGE = 86400    # seconds; older entries are dropped on the next write
NOTIFY_WINDOW = 60        # minutes counted as "recent" by ls/status/select
NOTIFY_SOUND = "Glass"

# A harness conversation can be replaced mid-session (claude's /clear starts a
# fresh one in the same process), so the ids are a history, newest last.
SESSION_ID_KEEP = 20

# What "ais install" writes into ~/.claude/CLAUDE.md — how an agent running
# inside a session is meant to use ais — between these markers, so a later
# install replaces its own section and nothing else.
CLAUDE_MD_BEGIN = "<!-- ais:begin -->"
CLAUDE_MD_END = "<!-- ais:end -->"

DEFAULT_CONFIG = '''\
# ais configuration.
#
# [defaults] applies to every harness; [harness.<name>] adds to it. The harness
# name is the token you type after "--" (its basename if you pass a path), so
# "ais -- claude" reads [harness.claude] and "ais -- pi.dev" reads
# [harness."pi.dev"].
#
# Final argv is:   <command> <config flags> <args you typed after the harness>
# Yours come last so the same flag typed by hand overrides the config default.
#
# env values go through ~ and $VAR expansion.

[defaults]
flags = []

[defaults.env]
# MY_SHARED_VAR = "value"

[harness.claude]
flags = []
# command = ["claude"]   # override the executable, e.g. ["npx", "claude"]

[harness.claude.env]
# ANTHROPIC_LOG = "debug"

# [harness.<name>.session] teaches ais how that harness names conversations, so
# "ais restart" can pick one up where it left off. {id} is the conversation id:
# ais mints it (see "id") for a new session and replays it for a restart.
# Without this table a harness is still tracked, it just restarts fresh.
#
# [harness.claude.session]
# id = "uuid4"                     # or "short" for ais's own id alphabet
# new = ["--session-id", "{id}"]
# resume = ["--resume", "{id}"]
# conflicts = ["-c", "--continue", "--fork-session"]   # you typed it: ais keeps out

# [harness."pi.dev"]
# flags = []

# [notify] controls what "ais notify" does.
[notify]
# sound = "Glass"     # macOS notification sound; "" for silent
# window = 60         # minutes a notification stays "recent" in ls/status/select
# when_visible = "skip"  # or "send": notify even while you are looking at the pane
'''


def die(msg: str, code: int = 1):
    print(f"{PROG}: {msg}", file=sys.stderr)
    raise SystemExit(code)


def note(msg: str):
    print(f"{PROG}: {msg}", file=sys.stderr)


def now_iso() -> str:
    return datetime.now().astimezone().isoformat(timespec="seconds")


# ---------------------------------------------------------------- config

def load_config() -> dict:
    if not CONFIG_PATH.exists():
        AIS_HOME.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(DEFAULT_CONFIG)
        note(f"wrote a starter config to {tilde(CONFIG_PATH)}")
    try:
        with CONFIG_PATH.open("rb") as fh:
            return tomllib.load(fh)
    except tomllib.TOMLDecodeError as exc:
        die(f"{tilde(CONFIG_PATH)}: {exc}")


def harness_settings(config: dict, harness: str) -> dict:
    """Merge [defaults] with [harness.<harness>]; flags concatenate, env merges."""
    defaults = config.get("defaults") or {}
    table = config.get("harness") or {}
    specific = table.get(harness)
    if specific is None:
        specific = table.get(Path(harness).name) or {}

    for name, src in (("defaults", defaults), (f"harness.{harness}", specific)):
        if not isinstance(src, dict):
            die(f"config: [{name}] must be a table")

    flags = list(defaults.get("flags") or []) + list(specific.get("flags") or [])
    if not all(isinstance(f, str) for f in flags):
        die(f"config: flags for {harness} must be a list of strings")

    env = {}
    for src in (defaults.get("env") or {}, specific.get("env") or {}):
        if not isinstance(src, dict):
            die(f"config: env for {harness} must be a table")
        for key, value in src.items():
            if not isinstance(value, str):
                die(f"config: env.{key} must be a string")
            env[key] = os.path.expanduser(os.path.expandvars(value))

    command = specific.get("command") or [harness]
    if isinstance(command, str):
        command = [command]
    if not all(isinstance(c, str) for c in command):
        die(f"config: command for {harness} must be a string or list of strings")

    return {
        "flags": flags,
        "env": env,
        "command": list(command),
        "session": session_settings(specific.get("session"), harness),
    }


def session_settings(table, harness: str) -> dict | None:
    """Validate [harness.<name>.session]; None when the harness has no such table.

    Both templates are optional on their own: a harness that can resume but not
    be told its id up front still works, ais just has no id to give it until
    the harness reports one.
    """
    if table is None:
        return None
    if not isinstance(table, dict):
        die(f"config: [harness.{harness}.session] must be a table")

    out = {}
    for key in ("new", "resume", "conflicts"):
        value = table.get(key) or []
        if isinstance(value, str):
            value = [value]
        if not all(isinstance(v, str) for v in value):
            die(f"config: session.{key} for {harness} must be a list of strings")
        out[key] = list(value)

    kind = table.get("id", "uuid4")
    if kind not in ("uuid4", "short"):
        die(f'config: session.id for {harness} must be "uuid4" or "short"')
    out["id"] = kind

    for key in ("new", "resume"):
        if out[key] and not any("{id}" in part for part in out[key]):
            die(f"config: session.{key} for {harness} must contain {{id}} somewhere")

    # Asking for the same conversation twice, in two ways, is an argv error in
    # every harness worth supporting — so ais stands down when you name one.
    flags = {p for p in out["new"] + out["resume"] + out["conflicts"] if p.startswith("-")}
    out["conflicts"] = sorted(flags)
    return out


def session_argv(template: list[str], sid: str) -> list[str]:
    return [part.replace("{id}", sid) for part in template]


def mint_session_id(kind: str) -> str:
    if kind == "short":
        return "".join(secrets.choice(ID_ALPHABET) for _ in range(ID_LENGTH))
    return str(uuid.uuid4())


def names_a_session(argv: list[str], conflicts: list[str]) -> str | None:
    """The first session-naming flag the user typed themselves, if any.

    Matches "--resume x" and "--resume=x" alike; anything after a bare "--" is
    the harness's own business and is left alone.
    """
    for arg in argv:
        if arg == "--":
            break
        head = arg.split("=", 1)[0]
        if head in conflicts:
            return head
    return None


def notify_settings() -> dict:
    """Read [notify] without forcing a config write when there is nothing to read."""
    table = {}
    if CONFIG_PATH.exists():
        try:
            with CONFIG_PATH.open("rb") as fh:
                table = (tomllib.load(fh).get("notify") or {})
        except tomllib.TOMLDecodeError as exc:
            die(f"{tilde(CONFIG_PATH)}: {exc}")
        if not isinstance(table, dict):
            die("config: [notify] must be a table")

    sound = table.get("sound", NOTIFY_SOUND)
    window = table.get("window", NOTIFY_WINDOW)
    when_visible = table.get("when_visible", "skip")
    if not isinstance(sound, str):
        die("config: notify.sound must be a string")
    if not isinstance(window, (int, float)) or isinstance(window, bool) or window < 0:
        die("config: notify.window must be a non-negative number of minutes")
    if when_visible not in ("skip", "send"):
        die('config: notify.when_visible must be "skip" or "send"')
    return {"sound": sound, "window": float(window), "when_visible": when_visible}


# ---------------------------------------------------------------- state

@contextmanager
def state_lock():
    """Exclusive lock around every read-modify-write of sessions.json."""
    AIS_HOME.mkdir(parents=True, exist_ok=True)
    fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def read_sessions() -> list[dict]:
    if not SESSIONS_PATH.exists():
        return []
    try:
        data = json.loads(SESSIONS_PATH.read_text() or "{}")
    except json.JSONDecodeError as exc:
        die(f"{tilde(SESSIONS_PATH)} is not valid JSON ({exc}); move it aside to start over")
    sessions = data.get("sessions") if isinstance(data, dict) else data
    return sessions if isinstance(sessions, list) else []


def write_sessions(sessions: list[dict]):
    AIS_HOME.mkdir(parents=True, exist_ok=True)
    payload = {"version": SESSIONS_VERSION, "sessions": sessions}
    tmp = SESSIONS_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(payload, indent=2) + "\n")
    os.replace(tmp, SESSIONS_PATH)  # atomic: readers never see a half file


def mutate_sessions(fn):
    """Apply fn to the session list under lock; return whatever fn returns."""
    with state_lock():
        sessions = read_sessions()
        result = fn(sessions)
        write_sessions(sessions)
        return result


def new_id(existing: set[str]) -> str:
    while True:
        sid = "".join(secrets.choice(ID_ALPHABET) for _ in range(ID_LENGTH))
        if sid not in existing:
            return sid


# ---------------------------------------------------------------- tmux

def tmux(*args: str, check: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["tmux", *args], capture_output=True, text=True, check=check
    )


def require_tmux() -> str:
    if not os.environ.get("TMUX"):
        die(
            "not inside tmux — ais tracks sessions so it can jump back to them, "
            "which needs a tmux pane. Start tmux first."
        )
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        die("inside tmux but $TMUX_PANE is unset; cannot locate this pane")
    if not shutil.which("tmux"):
        die("tmux not found on PATH")
    return pane


def capture_tmux_location(pane: str) -> dict | None:
    fmt = "#{session_name}\t#{session_id}\t#{window_id}\t#{window_index}\t#{pane_id}\t#{pane_index}"
    res = tmux("display-message", "-p", "-t", pane, "-F", fmt)
    if res.returncode != 0:
        return None
    parts = res.stdout.strip().split("\t")
    if len(parts) != 6:
        return None
    keys = ("session_name", "session_id", "window_id", "window_index", "pane_id", "pane_index")
    return dict(zip(keys, parts))


def live_panes() -> set[str]:
    res = tmux("list-panes", "-a", "-F", "#{pane_id}")
    if res.returncode != 0:
        return set()
    return set(res.stdout.split())


def pane_exists(pane_id: str | None, panes: set[str] | None = None) -> bool:
    if not pane_id:
        return False
    return pane_id in (panes if panes is not None else live_panes())


def pane_is_visible(pane_id: str | None) -> bool:
    """True when this pane is the one a tmux client is currently showing.

    Three conditions, all from tmux itself: the pane is the active pane of its
    window, that window is the active window of its session, and some client is
    attached to that session. Deliberately blind to whether the terminal
    emulator is the frontmost app — that is a second question, for later.

    Unknowable counts as not visible: a missed notification is worse than one
    that arrives while you are already reading the pane.
    """
    if not pane_id or not shutil.which("tmux"):
        return False
    res = tmux(
        "display-message", "-p", "-t", pane_id,
        "-F", "#{pane_active}\t#{window_active}\t#{session_attached}",
    )
    if res.returncode != 0:
        return False
    parts = res.stdout.strip().split("\t")
    if len(parts) != 3:
        return False
    try:
        return all(int(p) > 0 for p in parts)
    except ValueError:
        return False


def tmux_label(session: dict) -> str:
    loc = session.get("tmux") or {}
    if not loc:
        return "-"
    return f"{loc.get('session_name', '?')}:{loc.get('window_index', '?')}.{loc.get('pane_id', '?')}"


def jump_to(session: dict, client: str | None = None) -> int:
    """Point a tmux client at this session's pane.

    client names the client to move, for callers that know it better than tmux
    can infer it; see resolve_client, which is how cmd_select comes by one.
    """
    loc = session.get("tmux") or {}
    pane_id = loc.get("pane_id")
    if not pane_id:
        die(f"session {session['id']} has no recorded tmux location")
    if not pane_exists(pane_id):
        die(f"tmux pane {pane_id} for session {session['id']} is gone")

    target_session = loc.get("session_id") or loc.get("session_name")
    if client:
        res = tmux("switch-client", "-c", client, "-t", target_session)
    elif os.environ.get("TMUX"):
        res = tmux("switch-client", "-t", target_session)
    else:
        # Outside tmux: attaching is the only way to get a client onto it.
        res = tmux("attach-session", "-t", target_session)
    if res.returncode != 0:
        die(f"tmux: {res.stderr.strip() or 'could not reach that session'}")

    tmux("select-window", "-t", pane_id)
    tmux("select-pane", "-t", pane_id)
    return 0


# ---------------------------------------------------------------- reaping

def process_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists, just not ours
    return True


def reap(sessions: list[dict]) -> int:
    """Mark sessions dead when their process or tmux pane is gone.

    Only judges sessions recorded on this host: a pid from another machine says
    nothing about a pid here.
    """
    host = socket.gethostname()
    candidates = [
        s for s in sessions
        if s.get("status") == "active" and s.get("hostname") == host
    ]
    if not candidates:
        return 0

    panes = live_panes()  # one tmux call for the whole sweep
    reaped = 0
    for s in candidates:
        pid = s.get("pid")
        loc = s.get("tmux") or {}
        # pids get reused, so require both signals before declaring death
        if process_alive(pid) and pane_exists(loc.get("pane_id"), panes):
            continue
        s["status"] = "dead"
        s["ended_at"] = s.get("ended_at") or now_iso()
        s.setdefault("exit_code", None)
        s["reaped"] = True
        reaped += 1
    return reaped


# ---------------------------------------------------------------- display

def tilde(path) -> str:
    text = str(path)
    home = str(Path.home())
    return "~" + text[len(home):] if text.startswith(home) else text


def parse_stamp(text: str | None) -> datetime | None:
    if not text:
        return None
    try:
        return datetime.fromisoformat(text)
    except ValueError:
        return None


def seconds_since(text: str | None) -> float | None:
    then = parse_stamp(text)
    if then is None:
        return None
    return (datetime.now().astimezone() - then).total_seconds()


def age_str(secs: float | None) -> str:
    if secs is None:
        return "-"
    secs = int(secs)
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    if secs < 86400:
        return f"{secs // 3600}h"
    return f"{secs // 86400}d"


def age_of(session: dict) -> str:
    return age_str(seconds_since(session.get("started_at")))


def describe(session: dict) -> str:
    desc = (session.get("description") or "").strip()
    if desc:
        return desc
    return f"({session.get('harness', 'session')} in {tilde(session.get('cwd', '?'))})"


def elide(text: str, width: int) -> str:
    return text if len(text) <= width else text[: width - 1] + "…"


# ---------------------------------------------------------------- notify

def notifications_of(session: dict) -> list[dict]:
    items = session.get("notifications")
    return items if isinstance(items, list) else []


def last_notification(session: dict) -> dict | None:
    items = notifications_of(session)
    return items[-1] if items else None


def recent_notifications(session: dict, window_minutes: float) -> list[dict]:
    limit = window_minutes * 60
    out = []
    for n in notifications_of(session):
        secs = seconds_since(n.get("at"))
        if secs is not None and secs <= limit:
            out.append(n)
    return out


def notify_tag(session: dict | None) -> str:
    """The short human label that tells parallel sessions apart in a banner."""
    if session:
        tag = (session.get("description") or session.get("slug") or "").strip()
        if tag:
            return tag
    tag = (os.environ.get("AIS_SESSION_DESCRIPTION") or "").strip()
    return tag or os.environ.get("AIS_SESSION", "") or ""


def applescript_string(text: str) -> str:
    escaped = text.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def deliver_macos(title: str, message: str, sound: str) -> tuple[bool, str | None]:
    script = (
        f"display notification {applescript_string(message)} "
        f"with title {applescript_string(title)}"
    )
    if sound:
        script += f" sound name {applescript_string(sound)}"
    res = subprocess.run(
        ["osascript", "-e", script], capture_output=True, text=True
    )
    if res.returncode != 0:
        return False, res.stderr.strip() or "osascript failed"
    return True, None


def deliver_linux(title: str, message: str, sound: str) -> tuple[bool, str | None]:
    if not shutil.which("notify-send"):
        # Headless Linux gets its own backend later; the record is the fallback.
        return False, "no desktop notifier found (notify-send missing)"
    res = subprocess.run(
        ["notify-send", "--app-name=ais", title, message],
        capture_output=True, text=True,
    )
    if res.returncode != 0:
        return False, res.stderr.strip() or "notify-send failed"
    return True, None


def deliver_desktop(title: str, message: str, sound: str) -> tuple[bool, str | None]:
    if sys.platform == "darwin":
        return deliver_macos(title, message, sound)
    if sys.platform.startswith("linux"):
        return deliver_linux(title, message, sound)
    return False, f"no notification backend for {sys.platform}"


def record_notification(sid: str, entry: dict) -> bool:
    """Append entry to sid's notification list; returns False if sid is unknown."""
    def apply(sessions):
        target = next((s for s in sessions if s.get("id") == sid), None)
        if target is None:
            return False
        items = [n for n in notifications_of(target) if isinstance(n, dict)]
        items.append(entry)
        fresh = [
            n for n in items
            if (seconds_since(n.get("at")) or 0) <= NOTIFY_MAX_AGE
        ]
        target["notifications"] = (fresh or items)[-NOTIFY_KEEP:]
        return True

    return mutate_sessions(apply)


def cmd_notify(args):
    """Raise a desktop notification for this session and remember that it happened.

    Skipped — recorded, but not shown — while the session's own pane is the one
    on screen, since a banner about a pane you are reading is just noise.
    """
    message = " ".join(args.message).strip()
    if not message:
        die("nothing to say: ais notify \"the message\"")

    settings = notify_settings()
    sid = os.environ.get("AIS_SESSION")
    session = next((s for s in read_sessions() if s.get("id") == sid), None) if sid else None

    # The session's own recorded pane is the one that matters — $TMUX_PANE only
    # answers for the shell that happens to be running this command.
    pane_id = ((session or {}).get("tmux") or {}).get("pane_id") or os.environ.get("TMUX_PANE")
    visible = pane_is_visible(pane_id)
    suppress = visible and settings["when_visible"] == "skip" and not args.force

    tag = args.tag if args.tag is not None else notify_tag(session)
    harness = (session or {}).get("harness") or os.environ.get("AIS_HARNESS") or PROG
    title = args.title or (f"{harness} — {elide(tag, 40)}" if tag else harness)
    sound = "" if args.no_sound else settings["sound"]

    delivered, error = (False, None)
    if not suppress:
        delivered, error = deliver_desktop(title, message, sound)

    entry = {
        "at": now_iso(),
        "message": message,
        "delivered": delivered,
        "suppressed": suppress,
    }
    if error:
        entry["error"] = error

    if sid:
        if not record_notification(sid, entry):
            note(f"session {sid} is not on record; notification not remembered")
    elif not args.quiet:
        note("not inside an ais session; notification sent but not recorded")

    if error and not args.quiet:
        note(f"could not raise a desktop notification: {error}")
    if suppress and not args.quiet:
        note("pane is on screen; recorded without a banner (--force to override)")
    return 0 if (delivered or suppress) else 1


# ---------------------------------------------------------------- run

def cmd_run(args, harness_argv: list[str]):
    config = load_config()
    pane = require_tmux()

    harness = harness_argv[0]
    settings = harness_settings(config, harness)
    harness_args = harness_argv[1:]

    # Mint the conversation id here rather than discovering it later: known
    # before the child exists, it lands in the record in the same write as
    # everything else, and there is nothing to scrape afterwards.
    sid, session_flags = None, []
    conf = settings["session"]
    if conf and conf["new"]:
        typed = names_a_session(harness_args, conf["conflicts"])
        if typed:
            note(f"you passed {typed}; leaving the conversation id to {harness}")
        else:
            sid = mint_session_id(conf["id"])
            session_flags = session_argv(conf["new"], sid)

    argv = settings["command"] + settings["flags"] + session_flags + harness_args

    location = capture_tmux_location(pane)
    if location is None:
        die(f"could not read the tmux location of pane {pane}")

    session = {
        "id": None,  # assigned and appended under a single lock below
        "description": args.description,
        "harness": harness,
        "command": argv,
        "harness_args": harness_args,  # what restart replays, minus ais's own flags
        "session_ids": [sid] if sid else [],
        "status": "active",
        "pid": None,  # filled in once the child exists
        "hostname": socket.gethostname(),
        "cwd": os.getcwd(),
        "tmux": location,
        "started_at": now_iso(),
        "ended_at": None,
        "exit_code": None,
    }
    return launch(session, argv, settings, dry_run=args.dry_run)


def launch(session: dict, argv: list[str], settings: dict, dry_run: bool) -> int:
    """Register the session, run argv to completion, record how it ended.

    Shared by run and restart: everything that differs between them has already
    been decided by the time we get here.
    """
    exe = shutil.which(argv[0])
    if not exe:
        die(f"harness not found on PATH: {argv[0]}")

    harness = session["harness"]
    if dry_run:
        session["id"] = new_id({s.get("id") for s in read_sessions()})
    else:
        def register(sessions):
            session["id"] = new_id({s.get("id") for s in sessions})
            sessions.append(session)
        mutate_sessions(register)

    env = os.environ.copy()
    env.update(settings["env"])
    env["AIS_SESSION"] = session["id"]
    env["AIS_HARNESS"] = harness
    if session.get("description"):
        env["AIS_SESSION_DESCRIPTION"] = session["description"]

    if dry_run:
        print("session:", session["id"], "(dry run, not recorded)")
        print("command:", shlex.join(argv))
        for key, value in sorted(settings["env"].items()):
            print(f"env:     {key}={value}")
        print(f"env:     AIS_SESSION={session['id']}")
        print(f"env:     AIS_HARNESS={harness}")
        if session.get("description"):
            print(f"env:     AIS_SESSION_DESCRIPTION={session['description']}")
        if session.get("session_ids"):
            print(f"{harness}: {session['session_ids'][-1]}")
        print("cwd:    ", tilde(session["cwd"]))
        print("tmux:   ", tmux_label(session))
        return 0

    try:
        child = subprocess.Popen(argv, env=env, executable=exe, cwd=session["cwd"])
    except OSError as exc:
        finish(session["id"], 126)
        die(f"could not start {argv[0]}: {exc}")

    def update_pid(sessions):
        for s in sessions:
            if s["id"] == session["id"]:
                s["pid"] = child.pid
    mutate_sessions(update_pid)

    install_forwarding(child)
    code = wait_for(child)
    finish(session["id"], code)
    return code


def install_forwarding(child: subprocess.Popen):
    """Keep ais alive through the signals the harness should own.

    SIGINT/SIGWINCH already reach the child directly (same foreground process
    group), so ais just declines to die on them. SIGTERM/SIGHUP are forwarded,
    then ais waits so it can still write the session's exit status.

    These must be Python-level handlers, not SIG_IGN: exec resets handled
    signals to their default in the child, whereas SIG_IGN would be inherited
    and Ctrl-C would stop working inside the harness.
    """

    def ignore(signum, frame):
        pass

    def forward(signum, frame):
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass

    signal.signal(signal.SIGINT, ignore)
    signal.signal(signal.SIGQUIT, ignore)
    if hasattr(signal, "SIGWINCH"):
        signal.signal(signal.SIGWINCH, ignore)
    signal.signal(signal.SIGTERM, forward)
    signal.signal(signal.SIGHUP, forward)


def wait_for(child: subprocess.Popen) -> int:
    while True:
        try:
            status = child.wait()
            break
        except KeyboardInterrupt:
            continue  # the child owns Ctrl-C
    return 128 - status if status < 0 else status


def finish(session_id: str, code: int):
    def apply(sessions):
        for s in sessions:
            if s["id"] == session_id:
                s["status"] = "dead"
                s["ended_at"] = now_iso()
                s["exit_code"] = code
    mutate_sessions(apply)


# ---------------------------------------------------------------- harness sessions

def harness_session_id(session: dict) -> str | None:
    """The conversation the harness was last known to be in, or None."""
    ids = session.get("session_ids")
    return ids[-1] if isinstance(ids, list) and ids else None


def remember_session_id(sid: str, conversation: str) -> bool:
    """Append a conversation id to sid's history; False if sid is unknown."""
    def apply(sessions):
        target = next((s for s in sessions if s.get("id") == sid), None)
        if target is None:
            return False
        ids = [i for i in (target.get("session_ids") or []) if isinstance(i, str)]
        if ids and ids[-1] == conversation:
            return True  # same conversation, nothing moved
        ids.append(conversation)
        target["session_ids"] = ids[-SESSION_ID_KEEP:]
        return True

    return mutate_sessions(apply)


def ancestry() -> list[tuple[int, str]]:
    """This process's ancestors as (pid, command name), nearest first.

    Empty when ps cannot be read, which callers must treat as "unknown" rather
    than as evidence of anything.
    """
    res = subprocess.run(
        ["ps", "-Ao", "pid=,ppid=,comm="], capture_output=True, text=True
    )
    if res.returncode != 0:
        return []
    info = {}
    for line in res.stdout.splitlines():
        parts = line.split(maxsplit=2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            info[int(parts[0])] = (int(parts[1]), Path(parts[2].strip()).name)

    chain, pid, seen = [], os.getpid(), set()
    while pid in info and pid not in seen:
        seen.add(pid)
        pid, _ = info[pid]
        if pid <= 1:
            break
        chain.append((pid, info.get(pid, (0, ""))[1]))
    return chain


def speaks_for(session: dict) -> bool:
    """True when this process belongs to session's own harness process.

    AIS_SESSION is inherited by everything the harness spawns, including
    another harness — a nested "claude -p" would otherwise report its own
    throwaway conversation as the session's. So look up the ancestry for the
    nearest harness process: if there is one and it is not the one ais started,
    this is a nested run and it does not get to speak.

    Unknowable counts as yes: on the host that started it, the overwhelmingly
    common case is the genuine session, and silently recording nothing would be
    the worse failure.
    """
    pid = session.get("pid")
    chain = ancestry()
    if not pid or not chain:
        return True
    names = {Path(session.get("harness", "")).name, Path((session.get("command") or [""])[0]).name}
    names.discard("")
    for ancestor_pid, comm in chain:
        if ancestor_pid == pid:
            return True
        if comm in names:
            return False  # a nearer harness than ours: nested
    return False  # ais's harness process is nowhere above us


def cmd_session_seen(args):
    """Hidden: the harness telling ais which conversation it is in now.

    Wired up as a SessionStart hook by "ais install", so it also fires on
    /clear, /compact and resume — the moments where the id changes under a
    process ais has no other way to ask.

    Never fails loudly: a hook that errors is a hook that interrupts the work
    it was supposed to quietly observe.
    """
    try:
        return session_seen(args)
    except SystemExit:
        return 0
    except Exception:  # noqa: BLE001 - see the docstring
        return 0


def session_seen(args) -> int:
    conversation = args.id
    if not conversation:
        raw = ""
        if not sys.stdin.isatty():
            try:
                raw = sys.stdin.read()
            except OSError:
                raw = ""
        try:
            conversation = (json.loads(raw or "{}") or {}).get("session_id")
        except json.JSONDecodeError:
            conversation = None
    if not conversation:
        # No payload to read: the harness still exports its own id, and a hook
        # runs as its child. Only good for "which conversation am I in now",
        # which is exactly the question.
        for var in ("AIS_HARNESS_SESSION_ID", "CLAUDE_CODE_SESSION_ID"):
            conversation = os.environ.get(var)
            if conversation:
                break
    if not conversation:
        return 0  # nothing to record; not this hook's business to complain

    sid = os.environ.get("AIS_SESSION")
    if not sid:
        return 0  # a harness running outside ais

    session = next((s for s in read_sessions() if s.get("id") == sid), None)
    if session is None:
        return 0

    if session.get("hostname") != socket.gethostname() or not speaks_for(session):
        return 0

    if not remember_session_id(sid, conversation):
        return 0
    if args.verbose:
        note(f"{sid}: {session.get('harness', 'harness')} session {conversation}")
    return 0


# ---------------------------------------------------------------- restart

def pick_restartable(sessions: list[dict], wanted: str | None) -> dict:
    """The session ais restart should revive, or die trying to choose."""
    if wanted:
        matches = [s for s in sessions if s.get("id", "").startswith(wanted)]
        if not matches:
            die(f"no session with id starting {wanted!r}")
        if len(matches) > 1:
            die(f"{wanted!r} matches {len(matches)} sessions")
        return matches[0]

    # No id: the last thing that died here, which is nearly always the session
    # whose pane you are standing in.
    here, host = os.getcwd(), socket.gethostname()
    mine = [
        s for s in sessions
        if s.get("status") == "dead"
        and s.get("cwd") == here
        and s.get("hostname") == host
    ]
    if not mine:
        die(f"no dead session recorded in {tilde(here)}; name one: {PROG} restart <id>")
    mine.sort(key=lambda s: s.get("ended_at") or s.get("started_at") or "")
    return mine[-1]


def cmd_restart(args):
    """Start a session's harness again, in this pane, where it left off.

    A restart is its own session — new id, new pane, its own notifications —
    linked back to the one it continues. What it inherits is the part that has
    to stay put: the directory, the name (so the worktree still matches) and
    the harness conversation.
    """
    config = load_config()
    pane = require_tmux()

    sessions = mutate_sessions(lambda ss: (reap(ss), ss)[1])
    target = pick_restartable(sessions, args.id)
    host = socket.gethostname()

    if target.get("hostname") != host:
        die(
            f"session {target['id']} ran on {target.get('hostname', '?')}, not {host}; "
            "its conversation lives on that machine"
        )
    if target.get("status") == "active" and process_alive(target.get("pid")):
        die(f"session {target['id']} is still running — {PROG} select {target['id']}")
    cwd = target.get("cwd") or ""
    if not Path(cwd).is_dir():
        die(f"{tilde(cwd) or 'its directory'} is gone; nothing to restart into")

    harness = target.get("harness") or ""
    settings = harness_settings(config, harness)
    conf = settings["session"]
    harness_args = target.get("harness_args")
    if harness_args is None:
        # Recorded before ais kept the raw args: recover them from the argv it
        # did record, minus the parts ais put there itself.
        harness_args = strip_known_flags(
            (target.get("command") or [])[len(settings["command"]) + len(settings["flags"]):],
            conf["conflicts"] if conf else [],
        )

    conversation = harness_session_id(target)
    typed = names_a_session(harness_args, conf["conflicts"]) if conf else None
    session_flags, ids = [], []

    if typed:
        note(f"session {target['id']} was started with {typed}; leaving it to {harness}")
    elif not args.fresh and conversation and conf and conf["resume"]:
        session_flags = session_argv(conf["resume"], conversation)
        ids = [conversation]  # same conversation continues; the harness keeps the id
    elif not args.fresh and conversation:
        note(f"no session.resume configured for {harness}; starting a fresh conversation")
    if not session_flags and conf and conf["new"]:
        fresh = mint_session_id(conf["id"])
        session_flags = session_argv(conf["new"], fresh)
        ids = [fresh]

    argv = settings["command"] + settings["flags"] + session_flags + list(harness_args)

    location = capture_tmux_location(pane)
    if location is None:
        die(f"could not read the tmux location of pane {pane}")

    session = {
        "id": None,
        "description": target.get("description"),
        "slug": target.get("slug"),  # deliberately shared: same work, same worktree
        "harness": harness,
        "command": argv,
        "harness_args": list(harness_args),
        "session_ids": ids,
        "restart_of": target["id"],
        "status": "active",
        "pid": None,
        "hostname": host,
        "cwd": cwd,
        "tmux": location,
        "started_at": now_iso(),
        "ended_at": None,
        "exit_code": None,
    }

    what = f"resuming {conversation}" if ids and ids == [conversation] else "fresh conversation"
    note(f"restarting {target['id']} ({elide(describe(target), 48)}) — {what}")
    return launch(session, argv, settings, dry_run=args.dry_run)


def strip_known_flags(argv: list[str], flags: list[str]) -> list[str]:
    """Drop session-naming flags and their values from a recorded argv."""
    out, skip = [], False
    for arg in argv:
        if skip:
            skip = False
            continue
        head = arg.split("=", 1)[0]
        if head in flags:
            skip = "=" not in arg
            continue
        out.append(arg)
    return out


# ---------------------------------------------------------------- name

# Dropped when shortening a description: they never help tell two sessions apart.
STOPWORDS = {
    "a", "an", "the", "and", "or", "for", "of", "to", "in", "on", "at", "with",
    "from", "into", "my", "our", "this", "that", "it", "its", "be", "is", "are",
    "make", "just", "some", "up", "out", "please",
}
SLUG_WORDS = 4
SLUG_MAX = 32


def slugify(text: str) -> str:
    """Kebab-case a description down to the few words that identify it.

    Deterministic on purpose: the same description must always yield the same
    name, whoever asks and however many times.
    """
    ascii_text = (
        unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    )
    words = [w for w in re.split(r"[^A-Za-z0-9]+", ascii_text.lower()) if w]
    kept = [w for w in words if w not in STOPWORDS] or words

    out: list[str] = []
    for word in kept[:SLUG_WORDS]:
        if out and len("-".join(out)) + 1 + len(word) > SLUG_MAX:
            break  # stop at a word boundary rather than truncating mid-word
        out.append(word)
    return "-".join(out)[:SLUG_MAX].strip("-")


def cmd_name(args):
    """Print the session base name for worktrees, branches and the like.

    Derived once from the description, then persisted, so every later call in
    this session — in any repo — returns the same name.
    """
    sid = os.environ.get("AIS_SESSION")
    if not sid:
        note("not running inside an ais session; no session name to derive")
        return 1

    if args.set:
        chosen = slugify(args.set)
        if not chosen:
            die(f"{args.set!r} has no usable characters for a name")
        if not store_slug(sid, chosen, force=True):
            note(f"session {sid} is not on record; name not persisted")
        print(chosen)
        return 0

    existing = next((s for s in read_sessions() if s.get("id") == sid), None)
    if existing and existing.get("slug"):
        print(existing["slug"])
        return 0

    description = (
        (existing or {}).get("description")
        or os.environ.get("AIS_SESSION_DESCRIPTION")
        or ""
    )
    candidate = slugify(description) or sid

    if existing is None:
        # Session was pruned; still answer, just without remembering.
        print(candidate)
        return 0

    print(store_slug(sid, candidate) or candidate)
    return 0


def store_slug(sid: str, candidate: str, force: bool = False) -> str | None:
    """Persist a name for sid, disambiguating against other sessions' names.

    Returns the stored name, or None if sid is not on record.
    """
    def apply(sessions):
        target = next((s for s in sessions if s.get("id") == sid), None)
        if target is None:
            return None
        if target.get("slug") and not force:
            return target["slug"]
        taken = {
            s.get("slug") for s in sessions
            if s.get("slug") and s.get("id") != sid
        }
        name = candidate
        if name in taken:
            # Same description, different session: keep the readable stem and
            # let the id make it unique.
            name = f"{candidate[:SLUG_MAX - 5].rstrip('-')}-{sid[:4]}"
        target["slug"] = name
        return name

    return mutate_sessions(apply)


# ---------------------------------------------------------------- select

def active_sessions() -> list[dict]:
    sessions = mutate_sessions(lambda ss: (reap(ss), ss)[1])
    live = [s for s in sessions if s.get("status") == "active"]
    live.sort(key=lambda s: s.get("started_at") or "", reverse=True)
    return live


def client_exists(name: str) -> bool:
    res = tmux("list-clients", "-F", "#{client_name}")
    return name in res.stdout.splitlines()


def current_client() -> str | None:
    """The client tmux would act on for us, named explicitly.

    A popup has no $TMUX_PANE, but $TMUX still carries the session its client is
    attached to, which is all tmux needs to resolve "the current client" — so a
    popup can name the client it was opened from after all.
    """
    if not os.environ.get("TMUX"):
        return None
    res = tmux("display-message", "-p", "-F", "#{client_name}")
    if res.returncode != 0:
        return None
    return res.stdout.strip() or None


def resolve_client(name: str | None) -> str | None:
    """The client to move: what the caller named, else what tmux infers.

    A --client naming no live client is dropped rather than fatal. The usual
    reason is a key binding whose "#{client_name}" was never expanded, since
    display-popup passes its shell command through untouched, and inferring the
    client is both possible and what such a caller meant.
    """
    if name and not client_exists(name):
        name = None
    return name or current_client()


def client_pane(client: str | None) -> str | None:
    """The pane a client is looking at, for working out where "here" is.

    A popup has no $TMUX_PANE of its own, so the client it was opened from is
    the only route back to the pane the key was pressed in. Absent a client
    there is no "here" to mark, which is a missing marker and nothing worse.
    """
    if not client:
        return None
    res = tmux("display-message", "-p", "-c", client, "-F", "#{pane_id}")
    if res.returncode != 0:
        return None
    return res.stdout.strip() or None


def session_at_pane(pane_id: str | None, sessions: list[dict]) -> str | None:
    if not pane_id:
        return None
    for s in sessions:
        if (s.get("tmux") or {}).get("pane_id") == pane_id:
            return s.get("id")
    return None


def cmd_select(args):
    sessions = active_sessions()
    if not sessions:
        note("no active sessions")
        return 1

    window = notify_settings()["window"]
    # Sessions that have called for you float to the top, so jumping between
    # the ones that want attention is a matter of taking the first rows.
    sessions.sort(
        key=lambda s: (
            bool(recent_notifications(s, window)),
            (last_notification(s) or {}).get("at") or "",
        ),
        reverse=True,
    )

    client = resolve_client(args.client)
    here = os.environ.get("AIS_SESSION") or session_at_pane(
        client_pane(client), sessions
    )
    if args.id:
        matches = [s for s in sessions if s["id"].startswith(args.id)]
        if not matches:
            die(f"no active session with id starting {args.id!r}")
        if len(matches) > 1:
            die(f"{args.id!r} matches {len(matches)} sessions")
        return jump_to(matches[0], client)

    chosen = pick(sessions, here, window)
    if chosen is None:
        return 130
    return jump_to(chosen, client)


def pick(sessions: list[dict], here: str | None, window: float) -> dict | None:
    rows = []
    for s in sessions:
        fresh = recent_notifications(s, window)
        mark = "●" if fresh else ("*" if s["id"] == here else " ")
        if fresh:
            last = fresh[-1]
            trailer = f"{age_str(seconds_since(last.get('at'))):>4}  {elide(last.get('message', ''), 34)}"
        else:
            trailer = f"{'':>4}  {elide(tilde(s.get('cwd', '?')), 34)}"
        rows.append(
            "\t".join([
                s["id"],
                f"{mark} {elide(describe(s), 58):<58} {age_of(s):>4}  {s.get('harness', '?'):<10} {trailer}",
            ])
        )

    if shutil.which("fzf") and sys.stdin.isatty():
        preview = f"{shlex.quote(sys.executable)} {shlex.quote(os.path.abspath(__file__))} _preview {{1}}"
        res = subprocess.run(
            [
                "fzf",
                "--delimiter=\t",
                "--with-nth=2..",
                "--prompt=ais session> ",
                "--header=enter select   esc cancel   ● notified recently",
                "--height=~60%",
                "--reverse",
                "--preview", preview,
                "--preview-window=right:44%",
            ],
            input="\n".join(rows),
            capture_output=True,
            text=True,
        )
        if res.returncode != 0 or not res.stdout.strip():
            return None
        sid = res.stdout.split("\t", 1)[0].strip()
        return next((s for s in sessions if s["id"] == sid), None)

    # fzf missing or not a tty: numbered prompt
    for i, s in enumerate(sessions, 1):
        print(f"{i:>3}. {rows[i - 1].split(chr(9), 1)[1]}")
    try:
        answer = input("select> ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    if not answer.isdigit() or not 1 <= int(answer) <= len(sessions):
        die("not a valid selection")
    return sessions[int(answer) - 1]


def cmd_preview(args):
    """Hidden: renders the fzf preview pane for one session."""
    session = next((s for s in read_sessions() if s["id"] == args.id), None)
    if session is None:
        return 1
    fields = [
        ("id", session["id"]),
        ("name", session.get("slug") or "-"),
        ("status", session.get("status", "?")),
        ("harness", session.get("harness", "?")),
        ("age", age_of(session)),
        ("started", session.get("started_at", "?")),
        ("cwd", tilde(session.get("cwd", "?"))),
        ("tmux", tmux_label(session)),
        ("pid", str(session.get("pid") or "-")),
        ("host", session.get("hostname", "?")),
        (session.get("harness", "session"), harness_session_id(session) or "-"),
    ]
    if session.get("restart_of"):
        fields.append(("restart of", session["restart_of"]))
    desc = (session.get("description") or "").strip()
    if desc:
        print(desc)
        print()
    for key, value in fields:
        print(f"{key:>8}  {value}")
    print(f"{'command':>8}  {shlex.join(session.get('command') or [])}")

    items = notifications_of(session)[-5:]
    if items:
        print()
        print("notifications")
        for n in items:
            flag = "" if n.get("delivered") else "  (no banner)"
            stamp = age_str(seconds_since(n.get("at")))
            print(f"{stamp:>8}  {n.get('message', '')}{flag}")
    return 0


# ---------------------------------------------------------------- ls / prune / current

def cmd_ls(args):
    """ls: one line per session. status: the same, plus recent notifications.

    The NOTIFY column is the age of the last notification; "●" in the margin
    means it landed inside the notify window and is probably still waiting for
    you.
    """
    detail = getattr(args, "detail", False)
    window = getattr(args, "window", None)
    if window is None:
        window = notify_settings()["window"]

    sessions = mutate_sessions(lambda ss: (reap(ss), ss)[1])
    if not args.all:
        sessions = [s for s in sessions if s.get("status") == "active"]
    sessions.sort(key=lambda s: s.get("started_at") or "", reverse=True)
    if detail:
        # Whatever called for you goes first, most recent call at the top.
        sessions.sort(
            key=lambda s: (
                bool(recent_notifications(s, window)),
                (last_notification(s) or {}).get("at") or "",
            ),
            reverse=True,
        )
    if not sessions:
        note("no active sessions" if not args.all else "no sessions")
        return 0

    here = os.environ.get("AIS_SESSION")
    print(
        f"{'':1} {'ID':<11} {'STATUS':<7} {'AGE':>4} {'NOTIFY':>6} "
        f"{'HARNESS':<10} {'TMUX':<18} DESCRIPTION"
    )
    for s in sessions:
        last = last_notification(s)
        mark = "●" if recent_notifications(s, window) else ("*" if s["id"] == here else " ")
        print(
            f"{mark} {s['id']:<11} {s.get('status', '?'):<7} {age_of(s):>4} "
            f"{age_str(seconds_since((last or {}).get('at'))):>6} "
            f"{elide(s.get('harness', '?'), 10):<10} {elide(tmux_label(s), 18):<18} "
            f"{elide(describe(s), 48)}"
        )
        if detail:
            for n in recent_notifications(s, window)[-3:]:
                flag = "" if n.get("delivered") else "  (no banner)"
                stamp = age_str(seconds_since(n.get("at")))
                print(f"    {stamp:>4} ago  {n.get('message', '')}{flag}")
    if detail and not any(recent_notifications(s, window) for s in sessions):
        sys.stdout.flush()  # keep the note under the table, not above it
        note(f"no notifications in the last {int(window)}m")
    return 0


def cmd_prune(args):
    cutoff = time.time() - args.days * 86400

    def apply(sessions):
        reap(sessions)
        keep, dropped = [], 0
        for s in sessions:
            if s.get("status") == "active":
                keep.append(s)
                continue
            if args.all:
                dropped += 1
                continue
            ended = s.get("ended_at") or s.get("started_at")
            try:
                stamp = datetime.fromisoformat(ended).timestamp() if ended else 0
            except ValueError:
                stamp = 0
            if stamp < cutoff:
                dropped += 1
            else:
                keep.append(s)
        sessions[:] = keep
        return dropped

    dropped = mutate_sessions(apply)
    note(f"pruned {dropped} dead session(s)")
    return 0


# ---------------------------------------------------------------- install

CLAUDE_SESSION_CONFIG = '''
# Added by "ais install --harness claude": how claude names conversations, so
# "ais restart" can pick one up again.
[harness.claude.session]
id = "uuid4"
new = ["--session-id", "{id}"]
resume = ["--resume", "{id}"]
conflicts = ["-c", "--continue", "--fork-session"]
'''

CLAUDE_MD_SECTION = '''\
## Notifications

`ais notify` is how you get my attention. Use it instead of the built-in
notification tool, which suppresses itself whenever tmux/the terminal looks
active — which for me is always:

```
ais notify "the deps sweep finished; 3 tests still failing"
```

ALWAYS send one when you stop needing to do work and start needing me:

- you are asking a question and cannot proceed until I answer
- you hit a permission prompt, a login, or anything else only I can do
- a long-running job/task finished, whether it passed or failed
- you are done with the task and handing it back

One notification per stop, at the moment you stop — not before, not batched up
later. Say what happened and what you need, in one line, not "task complete".

Do not manage the details yourself:

- No `osascript`. `ais notify` picks the backend for the platform.
- No session tag in the message. It titles the banner with the session
  description, so I can tell parallel sessions apart already.
- No checking whether I am looking. It skips the banner when this session's own
  tmux pane is the one on screen, and records the notification either way. Pass
  `-f` only if I must see the banner regardless.

Outside an ais session it still notifies, just without a session tag, so calling
it unconditionally is safe.

I read them back with `ais status`, and sessions that notified recently sort to
the top of `ais select`.

## AI sessions (ais)

`ais` (`ais --help`) starts an agent harness with the right flags and env,
records the run in `~/.ais/sessions.json`, and can jump back to its tmux pane
later. When `$AIS_SESSION` is set you are running inside one:

- `$AIS_SESSION` — the 10-char ais id, e.g. `vw86nyuhe6`
- `$AIS_SESSION_DESCRIPTION` — what I said the session is for (may be unset)
- `$AIS_HARNESS` — the harness name, normally `claude`

Use these opportunistically, never require them: outside ais they are all unset
and every rule here just falls back to asking me.

`ais name` prints the session's base name — use it for worktrees, branches, and
anything else that needs to identify this work:

```
ais name            # -> build-cli-tool-stock   (empty + exit 1 outside ais)
ais name --set foo  # only when I ask for a different name
```

Do not derive that name yourself. ais derives it from the description once and
remembers it, so it stays the same across repos and however often you ask; a
name you invent per call would not. If I ask for a different name, set it with
`--set` rather than just using it, so the next call agrees with you.

Interacting with ais:

- `ais ls`, `ais ls -a`, `ais status`, `ais current` and `ais name` are
  read-only as far as my work is concerned. Run them freely when I ask what is
  running or which session is which.
- NEVER run `ais select`. It switches my tmux client to another session's pane,
  yanking my view away from wherever I am. That command is mine.
- NEVER start a session yourself — no `ais -- claude` (that nests a harness
  inside this one) and no launching an agent harness directly.
- NEVER run `ais restart`. It takes over the pane it runs in and puts another
  agent back to work; deciding that is mine.
- `~/.ais/sessions.json` belongs to ais, which locks it while writing. Never
  hand-edit it, and never clean up your own session entry: ais marks the session
  dead with its exit code when you terminate. `~/.ais/config.toml` is fine to
  edit when I ask.
'''


def claude_dir() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))


def ais_command() -> str:
    """How the hook should invoke ais: by name when PATH has it, else by path."""
    found = shutil.which(PROG)
    if found:
        return PROG
    return str(Path(__file__).resolve())


def backup(path: Path, dry: bool) -> None:
    if path.exists() and not dry:
        shutil.copy2(path, path.with_name(path.name + ".ais.bak"))


def report(action: str, path: Path, detail: str = "") -> None:
    print(f"{action:>12}  {tilde(path)}{'  ' + detail if detail else ''}")


def install_config(dry: bool) -> None:
    """Teach ais's own config how claude names conversations."""
    load_config()  # writes the starter config when there is none
    text = CONFIG_PATH.read_text()
    # The starter config ships the table commented out as documentation, so
    # only a live one counts as already installed.
    if re.search(r"^\s*\[harness\.claude\.session\]", text, re.MULTILINE):
        report("unchanged", CONFIG_PATH, "[harness.claude.session] already set")
        return
    if dry:
        report("would add", CONFIG_PATH, "[harness.claude.session]")
        return
    backup(CONFIG_PATH, dry)
    CONFIG_PATH.write_text(text.rstrip("\n") + "\n" + CLAUDE_SESSION_CONFIG)
    report("added", CONFIG_PATH, "[harness.claude.session]")


def install_hook(dry: bool, force: bool) -> None:
    """Wire SessionStart to "ais _session-seen" without disturbing the rest.

    claude fires SessionStart on startup, resume, /clear and /compact — every
    moment the conversation id can change — so this is what keeps the recorded
    id from going stale under a running process.
    """
    path = claude_dir() / "settings.json"
    try:
        settings = json.loads(path.read_text()) if path.exists() else {}
    except json.JSONDecodeError as exc:
        die(f"{tilde(path)} is not valid JSON ({exc}); fix it before installing")
    if not isinstance(settings, dict):
        die(f"{tilde(path)} does not contain a JSON object")

    command = f"{ais_command()} _session-seen"
    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        die(f"{tilde(path)}: \"hooks\" is not an object; fix it before installing")
    starts = hooks.setdefault("SessionStart", [])
    if not isinstance(starts, list):
        die(f"{tilde(path)}: \"hooks.SessionStart\" is not an array")

    mine = [
        h for matcher in starts if isinstance(matcher, dict)
        for h in (matcher.get("hooks") or []) if isinstance(h, dict)
        and "_session-seen" in str(h.get("command", ""))
    ]
    if mine and not force:
        stale = [h for h in mine if h.get("command") != command]
        if stale:
            report("check", path, f"SessionStart runs {stale[0].get('command')!r} (--force rewrites it)")
        else:
            report("unchanged", path, "SessionStart hook already installed")
        return
    if mine:
        for hook in mine:
            hook["command"] = command
    else:
        starts.append({"hooks": [{"type": "command", "command": command}]})

    if dry:
        report("would wire", path, f"SessionStart -> {command}")
        return
    backup(path, dry)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(settings, indent=2) + "\n")
    os.replace(tmp, path)
    report("wired", path, f"SessionStart -> {command}")


def install_claude_md(dry: bool) -> None:
    """Put the house rules for a session in CLAUDE.md, inside ais's markers."""
    path = claude_dir() / "CLAUDE.md"
    block = f"{CLAUDE_MD_BEGIN}\n{CLAUDE_MD_SECTION}{CLAUDE_MD_END}\n"
    text = path.read_text() if path.exists() else ""

    if CLAUDE_MD_BEGIN in text and CLAUDE_MD_END in text:
        head, rest = text.split(CLAUDE_MD_BEGIN, 1)
        _, tail = rest.split(CLAUDE_MD_END, 1)
        updated = head + block + tail.lstrip("\n")
        action = "unchanged" if updated == text else "replaced"
    else:
        updated = (text.rstrip("\n") + "\n\n" if text.strip() else "") + block
        action = "appended"

    if action == "unchanged":
        report("unchanged", path, "ais section already current")
        return
    if dry:
        report("would append" if action == "appended" else "would replace", path, "ais section")
        return
    backup(path, dry)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(updated)
    report(action, path, f"ais section ({CLAUDE_MD_BEGIN} … {CLAUDE_MD_END})")


def cmd_install(args):
    """Wire a harness up for session tracking and restart."""
    if args.harness != "claude":
        die(f"{PROG} install only knows how to wire up claude so far")
    if not shutil.which(args.harness):
        note(f"{args.harness} is not on PATH; installing the configuration anyway")

    install_config(args.dry_run)
    install_hook(args.dry_run, args.force)
    install_claude_md(args.dry_run)

    if not args.dry_run:
        print()
        sys.stdout.flush()  # keep the note under the report, not above it
        note("new claude sessions will record their conversation id; "
             "existing ones pick it up at the next /clear, /compact or restart")
    return 0


def cmd_current(args):
    sid = os.environ.get("AIS_SESSION")
    if not sid:
        note("not running inside an ais session")
        return 1
    session = next((s for s in read_sessions() if s["id"] == sid), None)
    if session is None:
        note(f"AIS_SESSION={sid} is not in {tilde(SESSIONS_PATH)}")
        return 1
    args.id = sid
    return cmd_preview(args)


# ---------------------------------------------------------------- cli

USAGE = f"""usage: {PROG} [options] -- <harness> [harness args...]
       {PROG} <command> [options]

run:
  {PROG} -- claude                     start claude in a tracked session
  {PROG} -d "fix the auth bug" -- claude
  -d, --description TEXT             what this session is for; shown by select
  -n, --dry-run                      print the command and env, run nothing

commands:
  select [id]      pick an active session and switch tmux to its pane;
                   sessions that notified recently are listed first, marked ●
                   --client NAME moves that client rather than the one tmux
                   infers; only needed where tmux cannot infer it.
  ls [-a]          list active sessions (-a: dead ones too), with the age of
                   each one's last notification
  status [-a]      ls plus the recent notifications themselves
  notify TEXT      raise a desktop notification for this session and record it.
                   Skipped, but still recorded, while this session's own pane is
                   the one on screen; -f/--force sends anyway.
                   -t/--title TEXT overrides the banner title,
                   --tag TEXT the session label in it, -q/--quiet the chatter.
  current          show the session this shell is running in
  name [--set N]   print this session's base name, for worktrees and branches;
                   derived from the description once, then stable for the
                   session's whole life. --set overrides it.
  restart [id]     run a dead session's harness again in this pane, resuming
                   its conversation; with no id, the last one that died here.
                   Keeps its directory and name, gets a new ais id.
                   --fresh starts a new conversation, -n/--dry-run shows the
                   command without running it.
  install          wire a harness up: session flags in config.toml for restart,
                   a SessionStart hook in ~/.claude/settings.json, and a section
                   in ~/.claude/CLAUDE.md telling the agent how to use ais from
                   inside a session. --harness NAME (default claude),
                   -n/--dry-run, --force to rewrite an existing hook.
  prune [--all]    drop dead sessions older than --days (default 7)

tmux:
  bind-key a display-popup -E -w 80% -h 60% -T " ais " \\
    "{tilde(Path(__file__).resolve())} select"

  Picking from that popup switches the client underneath it and the popup
  closes on its own, leaving you in the chosen session's pane. Do not pass
  --client '#{{client_name}}': display-popup hands its command to the shell
  unexpanded, so the format arrives literally. select works it out itself.

files:
  {tilde(CONFIG_PATH)}      per-harness flags and env, [notify] settings
  {tilde(SESSIONS_PATH)}    session state

ais must run inside tmux: a session it cannot jump back to is not worth tracking.
"""


def split_argv(argv: list[str]) -> tuple[list[str], list[str] | None]:
    """Split at the first bare '--'. Returns (ais args, harness argv or None)."""
    if "--" not in argv:
        return argv, None
    at = argv.index("--")
    return argv[:at], argv[at + 1:]


def main(argv: list[str]) -> int:
    ais_args, harness_argv = split_argv(argv)

    if harness_argv is not None:
        if not harness_argv:
            die("nothing after '--': name the agent harness, e.g. ais -- claude")
        parser = argparse.ArgumentParser(prog=PROG, add_help=False)
        parser.add_argument("-d", "--description", default=None)
        parser.add_argument("-n", "--dry-run", action="store_true")
        parser.add_argument("-h", "--help", action="store_true")
        args, unknown = parser.parse_known_args(ais_args)
        if args.help:
            print(USAGE, end="")
            return 0
        if unknown:
            die(f"unknown option(s) before '--': {' '.join(unknown)}")
        return cmd_run(args, harness_argv)

    if not ais_args or ais_args[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0

    commands = (
        "select", "ls", "status", "notify", "prune", "current", "name",
        "restart", "install", "_preview", "_session-seen",
    )
    if ais_args[0] not in commands:
        hint = f"; to run a harness, separate it with '--': {PROG} -- {shlex.join(ais_args)}"
        die(f"unknown command {ais_args[0]!r}{hint if not ais_args[0].startswith('-') else ''}")

    parser = argparse.ArgumentParser(prog=PROG, add_help=False)
    subs = parser.add_subparsers(dest="command")

    p_select = subs.add_parser("select", add_help=False)
    p_select.add_argument("id", nargs="?", default=None)
    p_select.add_argument("--client", default=None, metavar="NAME")
    p_select.set_defaults(fn=cmd_select)

    p_ls = subs.add_parser("ls", add_help=False)
    p_ls.add_argument("-a", "--all", action="store_true")
    p_ls.add_argument("--window", type=float, default=None, metavar="MIN")
    p_ls.set_defaults(fn=cmd_ls, detail=False)

    p_status = subs.add_parser("status", add_help=False)
    p_status.add_argument("-a", "--all", action="store_true")
    p_status.add_argument("--window", type=float, default=None, metavar="MIN")
    p_status.set_defaults(fn=cmd_ls, detail=True)

    p_notify = subs.add_parser("notify", add_help=False)
    p_notify.add_argument("message", nargs="+")
    p_notify.add_argument("-t", "--title", default=None)
    p_notify.add_argument("--tag", default=None)
    p_notify.add_argument("-f", "--force", action="store_true")
    p_notify.add_argument("--no-sound", action="store_true")
    p_notify.add_argument("-q", "--quiet", action="store_true")
    p_notify.set_defaults(fn=cmd_notify)

    p_prune = subs.add_parser("prune", add_help=False)
    p_prune.add_argument("--all", action="store_true", help="drop every dead session")
    p_prune.add_argument("--days", type=float, default=7)
    p_prune.set_defaults(fn=cmd_prune)

    p_current = subs.add_parser("current", add_help=False)
    p_current.set_defaults(fn=cmd_current)

    p_name = subs.add_parser("name", add_help=False)
    p_name.add_argument("--set", default=None, metavar="NAME")
    p_name.set_defaults(fn=cmd_name)

    p_restart = subs.add_parser("restart", add_help=False)
    p_restart.add_argument("id", nargs="?", default=None)
    p_restart.add_argument("--fresh", action="store_true")
    p_restart.add_argument("-n", "--dry-run", action="store_true")
    p_restart.set_defaults(fn=cmd_restart)

    p_install = subs.add_parser("install", add_help=False)
    p_install.add_argument("--harness", default="claude")
    p_install.add_argument("-n", "--dry-run", action="store_true")
    p_install.add_argument("--force", action="store_true")
    p_install.set_defaults(fn=cmd_install)

    p_preview = subs.add_parser("_preview", add_help=False)
    p_preview.add_argument("id")
    p_preview.set_defaults(fn=cmd_preview)

    p_seen = subs.add_parser("_session-seen", add_help=False)
    p_seen.add_argument("id", nargs="?", default=None)
    p_seen.add_argument("-v", "--verbose", action="store_true")
    p_seen.set_defaults(fn=cmd_session_seen)

    try:
        args = parser.parse_args(ais_args)
    except SystemExit:
        return 2
    if not getattr(args, "fn", None):
        die(f"unknown command {ais_args[0]!r}; try '{PROG} --help'")
    return args.fn(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except BrokenPipeError:
        os._exit(0)
