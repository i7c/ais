#!/usr/bin/env python3
"""A stand-in gh for the acceptance suite: one Projects (v2) board in a file.

State lives in $FAKE_LOG/gh/: project.json ({"items": [...]} as gh prints it),
comments.json (what "gh issue comment" was asked to post), closed (issue
URLs "gh issue view" reports as closed), subissues.json ({issue URL: [its
sub-issue URLs]}), blockedby.json ({issue URL: [URLs blocking it]}), calls.log (every
call), and an optional "fail" file naming a subcommand ("item-edit",
"item-list", "comment", "read-after-edit": "issue view" once a body was
written) that should fail.

Tickets: bodies.json ({issue URL: body}, what "issue edit --body-file"
writes), closes.json (what "issue close" was asked), created.json (issues
"issue create" made). The board's statuses are "statuses" (one per line) if
that file exists. Pull requests: prs.json ({branch: {url, number, state,
isDraft, body, reviewDecision, title}}); a test approves one by setting its
reviewDecision.
"""
import json, os, sys

root = os.path.join(os.environ["FAKE_LOG"], "gh")
os.makedirs(root, exist_ok=True)
board = os.path.join(root, "project.json")
args = sys.argv[1:]
with open(os.path.join(root, "calls.log"), "a") as fh:
    fh.write(" ".join(args) + "\n")

def opt(name):
    return args[args.index(name) + 1] if name in args else None

fail = open(os.path.join(root, "fail")).read().strip() if os.path.exists(os.path.join(root, "fail")) else ""
STATUSES = ["Todo", "ready", "scheduled", "In Progress", "Done"]
if os.path.exists(os.path.join(root, "statuses")):
    STATUSES = [l.strip() for l in open(os.path.join(root, "statuses")) if l.strip()]

def load():
    return json.load(open(board)) if os.path.exists(board) else {"items": []}

def jload(name, default):
    path = os.path.join(root, name)
    return json.load(open(path)) if os.path.exists(path) else default

def jsave(name, data):
    json.dump(data, open(os.path.join(root, name), "w"))

if args[:2] == ["project", "item-list"]:
    if fail == "item-list":
        sys.exit("HTTP 502: fake failure")
    print(json.dumps(load()))
elif args[:2] == ["project", "view"]:
    print(json.dumps({"id": "PVT_fake", "number": int(args[2])}))
elif args[:2] == ["project", "field-list"]:
    print(json.dumps({"fields": [
        {"id": "F_title", "name": "Title", "type": "ProjectV2Field"},
        {"id": "F_status", "name": "Status", "type": "ProjectV2SingleSelectField",
         "options": [{"id": "opt-" + s.replace(" ", "-"), "name": s} for s in STATUSES]},
    ]}))
elif args[:2] == ["project", "item-edit"]:
    if fail == "item-edit":
        sys.exit("HTTP 502: fake failure")
    if opt("--project-id") != "PVT_fake" or opt("--field-id") != "F_status":
        sys.exit("wrong project or field id")
    name = {"opt-" + s.replace(" ", "-"): s for s in STATUSES}.get(opt("--single-select-option-id"))
    data = load()
    for it in data["items"]:
        if it["id"] == opt("--id"):
            it["status"] = name
            break
    else:
        sys.exit("no such item " + str(opt("--id")))
    json.dump(data, open(board, "w"))
elif args[:2] == ["api", "graphql"]:
    # The one query flow makes: an issue's items on its boards.
    given = dict(a.split("=", 1) for a in args if "=" in a)
    if "projectItems" not in given.get("query", ""):
        sys.exit("fake gh does not know this query")
    nodes = [{"id": it["id"], "project": {"number": 3, "owner": {"login": "gpwsoi"}},
              "status": {"name": it["status"]} if it.get("status") else None,
              "autonomy": {"name": it["autonomy"]} if it.get("autonomy") else None}
             for it in load()["items"] if it["content"]["url"] == given["url"]]
    other = {"id": "PVTI_elsewhere", "project": {"number": 9, "owner": {"login": "gpwsoi"}},
             "status": {"name": "wrong board"}, "autonomy": None}
    title = next((it["title"] for it in load()["items"] if it["content"]["url"] == given["url"]), "")
    print(json.dumps({"data": {"resource": {"title": title, "projectItems": {"nodes": [other] + nodes}}}}))
elif args[:2] == ["issue", "view"]:
    if fail == "read-after-edit" and os.path.exists(os.path.join(root, "edited")):
        sys.exit("GraphQL: API rate limit already exceeded")
    url = args[2]
    path = os.path.join(root, "closed")
    closed = open(path).read().split() if os.path.exists(path) else []
    subs = jload("subissues.json", {})
    state = lambda u: "CLOSED" if u in closed else "OPEN"
    titles = {it["content"]["url"]: it["title"] for it in load()["items"]}
    titles.update({c["url"]: c["title"] for c in jload("created.json", [])})
    title = lambda u: titles.get(u, "ticket " + u.rsplit("/", 1)[-1])
    nodes = [{"url": u, "title": "sub " + u.rsplit("/", 1)[-1], "state": state(u)} for u in subs.get(url, [])]
    blk = jload("blockedby.json", {})
    blockers = [{"url": u, "title": "blocker", "state": state(u)} for u in blk.get(url, [])]
    parent = next(({"url": p, "title": title(p), "state": state(p)} for p, kids in subs.items() if url in kids), None)
    comments = [{"author": {"login": "ais"}, "createdAt": "2026-11-21T10:00:00Z", "body": c["body"]}
                for c in jload("comments.json", []) if c["url"] == url]
    print(json.dumps({"url": url, "number": int(url.rsplit("/", 1)[-1]), "title": title(url),
                      "body": jload("bodies.json", {}).get(url, ""), "state": state(url), "stateReason": "",
                      "issueType": None, "labels": [], "comments": comments, "parent": parent,
                      "subIssues": {"nodes": nodes, "totalCount": len(nodes)},
                      "blockedBy": {"nodes": blockers, "totalCount": len(blockers)},
                      "closedByPullRequestsReferences": []}))
elif args[:2] == ["issue", "edit"]:
    if fail == "edit":
        sys.exit("GraphQL: API rate limit already exceeded")
    bodies = jload("bodies.json", {})
    bodies[args[2]] = sys.stdin.read()
    jsave("bodies.json", bodies)
    if fail == "read-after-edit":
        open(os.path.join(root, "edited"), "w").close()
elif args[:2] == ["issue", "close"]:
    closes = jload("closes.json", [])
    closes.append({"url": args[2], "reason": opt("--reason"), "comment": opt("--comment")})
    jsave("closes.json", closes)
    with open(os.path.join(root, "closed"), "a") as fh:
        fh.write(args[2] + "\n")
elif args[:2] == ["issue", "create"]:
    created = jload("created.json", [])
    url = "https://github.com/%s/issues/%d" % (opt("-R"), 900 + len(created))
    created.append({"url": url, "title": opt("--title"), "body": sys.stdin.read(),
                    "parent": opt("--parent"), "blocked_by": opt("--blocked-by")})
    jsave("created.json", created)
    if opt("--parent"):
        subs = jload("subissues.json", {})
        subs.setdefault(opt("--parent"), []).append(url)
        jsave("subissues.json", subs)
    print(url)
elif args[:2] == ["project", "item-add"]:
    data = load()
    url = opt("--url")
    if not any(it["content"]["url"] == url for it in data["items"]):
        repo, n = url.split("github.com/")[1].split("/issues/")
        data["items"].append({"id": "PVTI_new_" + n, "status": "Todo", "title": "new " + n,
                              "content": {"type": "Issue", "url": url, "number": int(n), "repository": repo}})
        json.dump(data, open(board, "w"))
elif args[:2] == ["pr", "view"]:
    prs = jload("prs.json", {})
    if args[2] not in prs:
        sys.exit("no pull requests found for branch \"%s\"" % args[2])
    print(json.dumps(prs[args[2]]))
elif args[:2] == ["pr", "create"]:
    prs = jload("prs.json", {})
    branch = opt("--head")
    n = 500 + len(prs)
    prs[branch] = {"url": "https://github.com/gpwsoi/backend/pull/%d" % n, "number": n, "state": "OPEN",
                   "isDraft": "--draft" in args, "body": sys.stdin.read(), "reviewDecision": "",
                   "title": opt("--title"), "base": opt("--base")}
    jsave("prs.json", prs)
    print(prs[branch]["url"])
elif args[:2] in (["pr", "edit"], ["pr", "ready"]):
    prs = jload("prs.json", {})
    for pr in prs.values():
        if pr["url"] == args[2]:
            if args[1] == "edit":
                pr["body"] = sys.stdin.read()
            else:
                pr["isDraft"] = False
    jsave("prs.json", prs)
elif args[:2] == ["pr", "close"]:
    prs = jload("prs.json", {})
    for pr in prs.values():
        if pr["url"] == args[2]:
            pr["state"] = "CLOSED"
            pr["closeComment"] = opt("--comment")
    jsave("prs.json", prs)
elif args[:2] == ["repo", "view"]:
    print("gpwsoi/backend")
elif args[:2] == ["issue", "comment"]:
    if fail == "comment":
        sys.exit("HTTP 502: fake failure")
    path = os.path.join(root, "comments.json")
    comments = json.load(open(path)) if os.path.exists(path) else []
    comments.append({"url": args[2], "body": opt("--body")})
    json.dump(comments, open(path, "w"))
else:
    sys.exit("fake gh does not know: " + " ".join(args))
